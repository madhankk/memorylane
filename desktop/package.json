{
  "name": "@memorylane/desktop",
  "productName": "MemoryLane",
  "version": "0.1.0",
  "private": true,
  "description": "Tray app that manages the MemoryLane server process - start/stop/port, no terminal required.",
  "author": "Madhan Kanagavel",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && electron-forge start",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "package": "npm run build && npm run prepare-runtime && electron-forge package",
    "make": "npm run build && npm run prepare-runtime && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.7.4",
    "electron": "^43.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.2"
  }
}
